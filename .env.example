# Copy to .env. The demo works without an API key.
DEMO_MODE=true
ADAPTION_BASE_URL=
ADAPTION_API_KEY=

# Paste the exact model IDs supplied by your provider.
# Cheap model display name: DeepSeek V4 Flash
CHEAP_MODEL=
# Strong model display name: GLM 5.2
STRONG_MODEL=

# Rates shown in the model picker, in credits per million tokens.
# Set input and output separately if your account has different rates.
CHEAP_INPUT_PRICE_PER_1M=0.14
CHEAP_OUTPUT_PRICE_PER_1M=0.14
STRONG_INPUT_PRICE_PER_1M=4.40
STRONG_OUTPUT_PRICE_PER_1M=4.40
