# Copy to .env. The demo works without an API key.
DEMO_MODE=true
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
ADAPTION_API_KEY=

# Adaption IDs for DeepSeek V4 Flash and GLM 5.2.
CHEAP_MODEL=deepseek-v4-flash
STRONG_MODEL=glm-5.2

# Standard Adaption rates in credits per million tokens, before cache discounts.
CHEAP_INPUT_PRICE_PER_1M=0.045
CHEAP_OUTPUT_PRICE_PER_1M=0.14
STRONG_INPUT_PRICE_PER_1M=1.40
STRONG_OUTPUT_PRICE_PER_1M=4.40
